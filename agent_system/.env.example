# Data source: a directory containing the LMS json/csv files, OR a path to a .zip
LMS_DATA_SOURCE=.

# --- Agent 1: attendance rule ("13 ta darsdan 7 tadan kam kelsa") ---
ATTENDANCE_WINDOW_LESSONS=13
ATTENDANCE_MIN_PRESENT=7
BEHIND_STREAK_THRESHOLD=2

# --- Agent 2: ranking weights (sum to 1.0) ---
WEIGHT_ATTENDANCE=0.35
WEIGHT_HOMEWORK=0.30
WEIGHT_SCORE=0.35
WEAK_TOPIC_SCORE_THRESHOLD=65

# --- LLM: Agent 2 narrative recommendations + bot_server.py free-text AI chat ---
# Free option (recommended): console.groq.com/keys, no credit card, ~1 minute to get.
# If both are unset, recommendations fall back to templates and the bot's free-text
# questions fall back to the keyword router in queries.py — nothing breaks either way.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Agent 3: cloud DB (falls back to local SQLite queue if unset/unreachable) ---
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/lms

# --- Agent 3: Telegram (falls back to dry-run console sink if unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# --- Agent 3: MCP server (falls back to local no-op stub if unset) ---
MCP_SERVER_URL=

SYNC_INTERVAL_MINUTES=60
